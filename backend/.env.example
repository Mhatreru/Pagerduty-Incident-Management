# =====================================================================
# TEMPLATE FILE (.env.example) - DO NOT PUT REAL KEYS HERE
# Copy this file to '.env' and fill in your real credentials.
# =====================================================================

# System Execution Mode (true = offline mock mode, false = live integration)
OFFLINE_MODE=true

# Database Connection (SQLite local dev or PostgreSQL)
DATABASE_URL=sqlite:///./pagerduty_poc.db

# ---------------------------------------------------------------------
# PAGERDUTY INTEGRATION
# ---------------------------------------------------------------------
# PagerDuty Events API v2 Routing Key
PAGERDUTY_ROUTING_KEY=your_pagerduty_events_v2_routing_key_here
PAGERDUTY_API_TOKEN=your_pagerduty_api_token_here
PAGERDUTY_SERVICE_ID=your_pagerduty_service_id_here

# ---------------------------------------------------------------------
# GOOGLE GEMINI AI INTEGRATION
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# SERVICENOW ITSM INTEGRATION
# ---------------------------------------------------------------------
SERVICENOW_MOCK_ENABLED=true
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_servicenow_password

# ---------------------------------------------------------------------
# DYNATRACE WEBHOOK INTEGRATION
# ---------------------------------------------------------------------
DYNATRACE_WEBHOOK_SECRET=dynatrace_secret_token_nexus_poc_2026
